# NEXUS Environment Configuration
# Copy this file to .env and adjust values as needed.
# NEVER commit .env with real values.

# Backend
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000
NEXUS_DATA_DIR=%LOCALAPPDATA%\NEXUS
NEXUS_DB_PATH=%LOCALAPPDATA%\NEXUS\nexus.db
NEXUS_LOG_LEVEL=INFO

# Frontend (Vite proxy)
VITE_API_URL=http://127.0.0.1:8000

# Optional: GitHub API token for higher rate limits
# Store in OS credential manager in production; do not put real tokens here
# GITHUB_TOKEN=

# Optional: Obsidian vault path
# OBSIDIAN_VAULT_PATH=

# Optional: Custom Claude Code executable path (if not in PATH)
# CLAUDE_EXECUTABLE_PATH=

# Optional: CLAUDE_CONFIG_DIR override
# CLAUDE_CONFIG_DIR=